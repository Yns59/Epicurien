{% extends 'base.html.twig' %}

{% block title %}Mon profil — L'Épicurien {% endblock %}

{% block stylesheets %}
    <style>
        /* ── PAGE EDIT PROFIL ── */
        #edit-page {
            min-height: 100vh;
            padding: 10rem 2rem 6rem;
            background: var(--noir);
            display: flex;
            justify-content: center;
        }

        .edit-card {
            background: var(--noir-doux);
            border: 1px solid rgba(184,150,90,0.25);
            max-width: 560px;
            width: 100%;
            padding: 3.5rem 3rem;
            position: relative;
        }

        .edit-card::before {
            content: '';
            position: absolute;
            top: -1px; left: 50%;
            transform: translateX(-50%);
            width: 80px; height: 1px;
            background: var(--or);
        }

        .edit-title {
            font-family: var(--serif);
            font-size: 2.2rem;
            font-weight: 300;
            text-align: center;
            color: var(--blanc);
            margin-bottom: 0.5rem;
            line-height: 1.1;
        }
        .edit-title em { font-style: italic; color: var(--or-clair); }

        .edit-subtitle {
            font-size: 0.95rem;
            font-style: italic;
            font-weight: 300;
            color: var(--gris);
            text-align: center;
            margin-bottom: 2.5rem;
        }

        .edit-ornement {
            display: flex;
            align-items: center;
            gap: 1rem;
            justify-content: center;
            margin-bottom: 2.5rem;
        }
        .edit-ornement-line {
            width: 40px; height: 1px;
            background: linear-gradient(to right, transparent, var(--or));
        }
        .edit-ornement-line.right { background: linear-gradient(to left, transparent, var(--or)); }
        .edit-ornement-diamond {
            width: 6px; height: 6px;
            background: var(--or);
            transform: rotate(45deg);
        }

        .edit-form {
            display: flex;
            flex-direction: column;
            gap: 1.4rem;
        }

        .edit-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        .edit-group {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }
        .edit-group label {
            font-family: var(--sans);
            font-size: 0.62rem;
            font-weight: 200;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            color: var(--gris);
        }
        .edit-group .form-error {
            font-size: 0.78rem;
            font-weight: 300;
            font-style: italic;
            color: #e8a39c;
        }
        .edit-group input,
        .edit-group textarea,
        .edit-group select {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(184,150,90,0.25);
            color: var(--creme);
            padding: 0.85rem 1rem;
            font-family: var(--serif);
            font-size: 1rem;
            font-weight: 300;
            transition: border-color 0.3s, background 0.3s;
            outline: none;
            width: 100%;
        }
        .edit-group input:focus,
        .edit-group textarea:focus,
        .edit-group select:focus {
            border-color: var(--or);
            background: rgba(255,255,255,0.06);
        }
        .edit-group input::placeholder { color: var(--gris); opacity: 0.5; }

        .edit-hint {
            font-size: 0.78rem;
            font-weight: 300;
            font-style: italic;
            color: var(--gris);
            margin-top: -0.2rem;
        }

        .edit-submit {
            font-family: var(--sans);
            font-size: 0.72rem;
            font-weight: 300;
            letter-spacing: 0.25em;
            text-transform: uppercase;
            color: var(--noir);
            background: var(--or);
            border: none;
            padding: 1.1rem 2rem;
            cursor: pointer;
            transition: background 0.3s, transform 0.2s;
            margin-top: 0.8rem;
        }
        .edit-submit:hover { background: var(--or-clair); transform: translateY(-2px); }

        .edit-back {
            position: absolute;
            top: 2rem; left: 2rem;
            font-family: var(--sans);
            font-size: 0.65rem;
            font-weight: 300;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--gris);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: color 0.3s;
            z-index: 5;
        }
        .edit-back:hover { color: var(--or); }
        .edit-back svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 2; }

        .edit-flash {
            background: rgba(39,174,96,0.1);
            border: 1px solid rgba(39,174,96,0.3);
            color: #8fd9ae;
            font-size: 0.85rem;
            font-weight: 300;
            padding: 0.9rem 1.2rem;
            margin-bottom: 1.5rem;
        }

        @media (max-width: 560px) {
            .edit-card { padding: 2.5rem 1.8rem; }
            .edit-row { grid-template-columns: 1fr; }
            .edit-back { top: 1.2rem; left: 1.2rem; }
        }
    </style>
{% endblock %}

{% block javascripts %}{% endblock %}

{% block body %}
    <a href="{{ path('app_home') }}" class="edit-back">
        <svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Retour au site
    </a>

    <section id="edit-page">
        <div class="edit-card reveal visible">

            <h1 class="edit-title">Mon <em>profil</em></h1>
            <p class="edit-subtitle">Modifiez vos informations personnelles</p>

            <div class="edit-ornement">
                <div class="edit-ornement-line"></div>
                <div class="edit-ornement-diamond"></div>
                <div class="edit-ornement-line right"></div>
            </div>

            {% for message in app.flashes('success') %}
                <div class="edit-flash">{{ message }}</div>
            {% endfor %}

            {{ form_start(form, {'attr': {'class': 'edit-form'}}) }}

            <div class="edit-row">
                <div class="edit-group">
                    {{ form_label(form.name, 'Nom') }}
                    {{ form_widget(form.name, {'attr': {'placeholder': 'Dupont'}}) }}
                    {{ form_errors(form.name) }}
                </div>
                <div class="edit-group">
                    {{ form_label(form.lastname, 'Prénom') }}
                    {{ form_widget(form.lastname, {'attr': {'placeholder': 'Jean'}}) }}
                    {{ form_errors(form.lastname) }}
                </div>
            </div>

            {{ form_rest(form) }}

            <button type="submit" class="edit-submit">Enregistrer les modifications</button>

            {{ form_end(form) }}

        </div>
    </section>
{% endblock %}
