

{% block title %}{% endblock %}
{% block meta_description %}{% endblock %}

{% block stylesheets %}
    <style>
        /* ── PAGE HEADER ── */
        .page-header {
            min-height: 40vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 10rem 2rem 5rem;
            background:
                linear-gradient(to bottom, rgba(14,13,11,0.7), rgba(14,13,11,0.9)),
                url('{{ asset("images/galerie-1.jpg") }}') center/cover no-repeat;
        }

        /* ── GALERIE ── */
        #galerie { background: var(--brun); }
        .galerie-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            grid-template-rows: 280px 280px;
            gap: 6px;
        }
        .galerie-item {
            overflow: hidden;
            position: relative;
        }
        .galerie-item:first-child { grid-row: span 2; }
        .galerie-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s ease;
            display: block;
        }
        .galerie-item:hover img { transform: scale(1.06); }
        .galerie-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(14,13,11,0.6), transparent);
            opacity: 0;
            transition: opacity 0.4s;
        }
        .galerie-item:hover .galerie-overlay { opacity: 1; }

        @media (max-width: 900px) {
            .galerie-grid {
                grid-template-columns: 1fr 1fr;
                grid-template-rows: repeat(3, 200px);
            }
            .galerie-item:first-child { grid-row: span 1; }
        }
        @media (max-width: 600px) {
            .galerie-grid { grid-template-columns: 1fr; grid-template-rows: repeat(5, 200px); }
        }
    </style>
{% endblock %}

{% block body %}




    {# ── EN-TÊTE DE PAGE ── #}
    <div class="page-header">
        <p class="section-label" style="animation: fadeUp 1s 0.2s both;">Galerie</p>
        <h1 class="section-title" style="animation: fadeUp 1s 0.4s both;">L'<em>atmosphère</em> du 44</h1>
        <div class="ornement" style="animation: fadeUp 1s 0.5s both; margin-bottom:0;"><div class="ornement-line"></div><div class="ornement-diamond"></div><div class="ornement-line right"></div></div>
    </div>

    {# ── GALERIE ── #}
    <section id="galerie">
        <div class="container">
            <div class="galerie-grid reveal">
                <div class="galerie-item">
                    <img src="{{ asset('images/galerie-1.jpg') }}" alt="Salle du restaurant" loading="lazy">
                    <div class="galerie-overlay"></div>
                </div>
                <div class="galerie-item">
                    <img src="{{ asset('images/galerie-2.jpg') }}" alt="Plat signature" loading="lazy">
                    <div class="galerie-overlay"></div>
                </div>
                <div class="galerie-item">
                    <img src="{{ asset('images/galerie-3.jpg') }}" alt="Carte des vins" loading="lazy">
                    <div class="galerie-overlay"></div>
                </div>
                <div class="galerie-item">
                    <img src="{{ asset('images/galerie-4.jpg') }}" alt="Terrasse" loading="lazy">
                    <div class="galerie-overlay"></div>
                </div>
                <div class="galerie-item">
                    <img src="{{ asset('images/galerie-5.jpg') }}" alt="Cuisine ouverte" loading="lazy">
                    <div class="galerie-overlay"></div>
                </div>
            </div>
        </div>
    </section>

{% endblock %}
