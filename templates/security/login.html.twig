{% extends 'base.html.twig' %}

{% block title %}Connexion — Le 44 de Seclin{% endblock %}

{% block stylesheets %}
    <style>
        /* ── PAGE LOGIN ── */
        #auth-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 10rem 2rem 5rem;
            background:
                linear-gradient(to bottom, rgba(14,13,11,0.75), rgba(14,13,11,0.92)),
                url('{{ asset("images/hero-restaurant.jpg") }}') center/cover no-repeat;
            position: relative;
        }

        .auth-card {
            background: var(--noir-doux);
            border: 1px solid rgba(184,150,90,0.25);
            max-width: 440px;
            width: 100%;
            padding: 3.5rem 3rem;
            position: relative;
        }

        .auth-card::before {
            content: '';
            position: absolute;
            top: -1px; left: 50%;
            transform: translateX(-50%);
            width: 80px; height: 1px;
            background: var(--or);
        }

        .auth-logo {
            text-align: center;
            margin-bottom: 2rem;
        }
        .auth-logo a {
            font-family: var(--serif);
            font-size: 1.6rem;
            font-weight: 300;
            letter-spacing: 0.05em;
            color: var(--or);
            text-decoration: none;
        }
        .auth-logo a span {
            font-style: italic;
            color: var(--creme);
        }

        .auth-title {
            font-family: var(--serif);
            font-size: 2.2rem;
            font-weight: 300;
            text-align: center;
            color: var(--blanc);
            margin-bottom: 0.5rem;
            line-height: 1.1;
        }
        .auth-title em { font-style: italic; color: var(--or-clair); }

        .auth-subtitle {
            font-size: 0.95rem;
            font-style: italic;
            font-weight: 300;
            color: var(--gris);
            text-align: center;
            margin-bottom: 2.5rem;
        }

        .auth-ornement {
            display: flex;
            align-items: center;
            gap: 1rem;
            justify-content: center;
            margin-bottom: 2.5rem;
        }
        .auth-ornement-line {
            width: 40px; height: 1px;
            background: linear-gradient(to right, transparent, var(--or));
        }
        .auth-ornement-line.right { background: linear-gradient(to left, transparent, var(--or)); }
        .auth-ornement-diamond {
            width: 6px; height: 6px;
            background: var(--or);
            transform: rotate(45deg);
        }

        .auth-form {
            display: flex;
            flex-direction: column;
            gap: 1.4rem;
        }

        .auth-group {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }
        .auth-group label {
            font-family: var(--sans);
            font-size: 0.62rem;
            font-weight: 200;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            color: var(--gris);
        }
        .auth-group input {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(184,150,90,0.25);
            color: var(--creme);
            padding: 0.85rem 1rem;
            font-family: var(--serif);
            font-size: 1rem;
            font-weight: 300;
            transition: border-color 0.3s, background 0.3s;
            outline: none;
            width: 100%;
        }
        .auth-group input:focus {
            border-color: var(--or);
            background: rgba(255,255,255,0.06);
        }
        .auth-group input::placeholder {
            color: var(--gris);
            opacity: 0.5;
        }

        .auth-row-between {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 0.8rem;
            margin-top: -0.4rem;
        }

        .auth-checkbox {
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }
        .auth-checkbox input[type="checkbox"] {
            width: 16px; height: 16px;
            accent-color: var(--or);
            cursor: pointer;
            flex-shrink: 0;
        }
        .auth-checkbox label {
            font-size: 0.85rem;
            font-weight: 300;
            color: var(--gris);
            cursor: pointer;
        }

        .auth-forgot {
            font-size: 0.82rem;
            font-weight: 300;
            color: var(--or-clair);
            text-decoration: none;
            border-bottom: 1px solid rgba(212,176,122,0.3);
            transition: border-color 0.3s;
        }
        .auth-forgot:hover { border-color: var(--or-clair); }

        .auth-submit {
            font-family: var(--sans);
            font-size: 0.72rem;
            font-weight: 300;
            letter-spacing: 0.25em;
            text-transform: uppercase;
            color: var(--noir);
            background: var(--or);
            border: none;
            padding: 1.1rem 2rem;
            cursor: pointer;
            transition: background 0.3s, transform 0.2s;
            margin-top: 0.5rem;
        }
        .auth-submit:hover { background: var(--or-clair); transform: translateY(-2px); }

        .auth-divider {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin: 1.8rem 0;
        }
        .auth-divider::before,
        .auth-divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: rgba(184,150,90,0.15);
        }
        .auth-divider span {
            font-family: var(--sans);
            font-size: 0.62rem;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--gris);
        }

        .auth-footer {
            text-align: center;
            font-size: 0.9rem;
            font-weight: 300;
            font-style: italic;
            color: var(--gris);
        }
        .auth-footer a {
            color: var(--or-clair);
            text-decoration: none;
            font-style: normal;
            border-bottom: 1px solid rgba(212,176,122,0.3);
            transition: border-color 0.3s;
        }
        .auth-footer a:hover { border-color: var(--or-clair); }

        .auth-error {
            background: rgba(192,57,43,0.1);
            border: 1px solid rgba(192,57,43,0.3);
            color: #e8a39c;
            font-size: 0.85rem;
            font-weight: 300;
            padding: 0.9rem 1.2rem;
            margin-bottom: 1.5rem;
        }

        .auth-back {
            position: absolute;
            top: 2rem; left: 2rem;
            font-family: var(--sans);
            font-size: 0.65rem;
            font-weight: 300;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--gris);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: color 0.3s;
            z-index: 5;
        }
        .auth-back:hover { color: var(--or); }
        .auth-back svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 2; }

        @media (max-width: 560px) {
            .auth-card { padding: 2.5rem 1.8rem; }
            .auth-back { top: 1.2rem; left: 1.2rem; }
        }
    </style>
{% endblock %}

{% block javascripts %}{% endblock %}

{% block body %}
    <a href="{{ path('app_home') }}" class="auth-back">
        <svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Retour au site
    </a>

    <section id="auth-page">
        <div class="auth-card reveal visible">

            <div class="auth-logo">
                <a href="{{ path('app_home') }}">Le <span>44</span> de Seclin</a>
            </div>

            <h1 class="auth-title">Bon <em>retour</em></h1>
            <p class="auth-subtitle">Connectez-vous à votre compte</p>

            <div class="auth-ornement">
                <div class="auth-ornement-line"></div>
                <div class="auth-ornement-diamond"></div>
                <div class="auth-ornement-line right"></div>
            </div>

            {% if error %}
                <div class="auth-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <form class="auth-form" method="post" action="{{ path('app_login') }}">
                <div class="auth-group">
                    <label for="username">Adresse email</label>
                    <input type="email" id="username" name="_username" value="{{ last_username }}" required placeholder="jean.dupont@email.com" autocomplete="email" autofocus>
                </div>

                <div class="auth-group">
                    <label for="password">Mot de passe</label>
                    <input type="password" id="password" name="_password" required placeholder="••••••••" autocomplete="current-password">
                </div>

                <div class="auth-row-between">
                    <div class="auth-checkbox">
                        <input type="checkbox" id="remember_me" name="_remember_me">
                        <label for="remember_me">Se souvenir de moi</label>
                    </div>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="auth-submit">Se connecter</button>
            </form>

            <div class="auth-divider"><span>ou</span></div>

            <p class="auth-footer">
                Pas encore de compte ? <a href="{{ path('app_register') }}">Inscrivez-vous</a>
            </p>
        </div>
    </section>
{% endblock %}
