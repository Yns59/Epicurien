<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %} L'Épicurien — Restaurant{% endblock %}</title>
    <meta name="description" content="{% block meta_description %} , restaurant gastronomique au cœur de lille. Cuisine française raffinée, ambiance chaleureuse.{% endblock %}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Josefin+Sans:wght@200;300;400&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --or: #b8965a;
            --or-clair: #d4b07a;
            --or-pale: #f0e0c0;
            --noir: #0e0d0b;
            --noir-doux: #1a1814;
            --brun: #2c2418;
            --creme: #f5f0e8;
            --creme-pale: #faf7f2;
            --gris: #8a8070;
            --blanc: #ffffff;
            --serif: 'Cormorant Garamond', Georgia, serif;
            --sans: 'Josefin Sans', sans-serif;
        }

        html { scroll-behavior: smooth; }

        body {
            font-family: var(--serif);
            background-color: var(--noir);
            color: var(--creme);
            overflow-x: hidden;
        }

        /* ── NAV ── */
        nav {
            position: fixed;
            top: 0; left: 0; right: 0;
            z-index: 100;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1.5rem 4rem;
            transition: background 0.4s, padding 0.4s;
        }
        nav.scrolled {
            background: rgba(14, 13, 11, 0.97);
            padding: 1rem 4rem;
            border-bottom: 1px solid rgba(184, 150, 90, 0.2);
        }
        .nav-logo {
            font-family: var(--serif);
            font-size: 1.5rem;
            font-weight: 300;
            letter-spacing: 0.08em;
            color: var(--or);
            text-decoration: none;
        }
        .nav-logo span { font-style: italic; color: var(--creme); }
        .nav-links {
            display: flex;
            gap: 2.5rem;
            list-style: none;
        }
        .nav-links a {
            font-family: var(--sans);
            font-size: 0.72rem;
            font-weight: 300;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--creme);
            text-decoration: none;
            position: relative;
            transition: color 0.3s;
        }
        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -4px; left: 0;
            width: 0; height: 1px;
            background: var(--or);
            transition: width 0.3s;
        }
        .nav-links a:hover { color: var(--or); }
        .nav-links a:hover::after { width: 100%; }
        .nav-cta {
            font-family: var(--sans);
            font-size: 0.72rem;
            font-weight: 300;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--noir);
            background: var(--or);
            padding: 0.65rem 1.6rem;
            text-decoration: none;
            transition: background 0.3s, color 0.3s;
            border: none;
            cursor: pointer;
            display: inline-block;
        }
        .nav-cta:hover { background: var(--or-clair); }

        .nav-user {
            position: relative;
        }
        .nav-user-trigger {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            background: transparent;
            border: 1px solid rgba(184,150,90,0.3);
            padding: 0.5rem 1rem;
            cursor: pointer;
            transition: border-color 0.3s, background 0.3s;
        }
        .nav-user-trigger:hover,
        .nav-user.open .nav-user-trigger {
            border-color: var(--or);
            background: rgba(184,150,90,0.08);
        }
        .nav-user-name {
            font-family: var(--sans);
            font-size: 0.72rem;
            font-weight: 300;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            color: var(--or-clair);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .nav-user-name::before {
            content: '';
            width: 6px; height: 6px;
            background: var(--or);
            border-radius: 50%;
            display: inline-block;
            flex-shrink: 0;
        }
        .nav-user-chevron {
            width: 9px; height: 9px;
            stroke: var(--gris);
            fill: none;
            stroke-width: 2;
            transition: transform 0.3s;
        }
        .nav-user.open .nav-user-chevron { transform: rotate(180deg); }

        .nav-user-panel {
            position: absolute;
            top: calc(100% + 0.8rem);
            right: 0;
            width: 260px;
            background: var(--noir-doux);
            border: 1px solid rgba(184,150,90,0.25);
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px);
            transition: opacity 0.25s, transform 0.25s, visibility 0.25s;
            z-index: 50;
        }
        .nav-user.open .nav-user-panel {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }
        .nav-user-panel::before {
            content: '';
            position: absolute;
            top: -1px; right: 1.4rem;
            width: 80px; height: 1px;
            background: var(--or);
        }
        .nav-user-panel-header {
            padding: 1.4rem 1.4rem 1.1rem;
            border-bottom: 1px solid rgba(184,150,90,0.15);
        }
        .nav-user-panel-name {
            font-family: var(--serif);
            font-size: 1.25rem;
            font-weight: 400;
            color: var(--blanc);
            margin-bottom: 0.3rem;
        }
        .nav-user-panel-mail {
            font-family: var(--sans);
            font-size: 0.78rem;
            font-weight: 300;
            color: var(--gris);
            word-break: break-all;
        }
        .nav-user-panel-body {
            padding: 1rem 1.4rem;
            display: flex;
            flex-direction: column;
            gap: 0.85rem;
        }
        .nav-user-panel-row {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 1rem;
        }
        .nav-user-panel-label {
            font-family: var(--sans);
            font-size: 0.6rem;
            font-weight: 200;
            letter-spacing: 0.25em;
            text-transform: uppercase;
            color: var(--gris);
            opacity: 0.8;
        }
        .nav-user-panel-value {
            font-family: var(--serif);
            font-size: 0.95rem;
            font-weight: 300;
            color: var(--creme);
            text-align: right;
        }
        .nav-user-panel-footer {
            border-top: 1px solid rgba(184,150,90,0.15);
            padding: 0.9rem 1.4rem;
        }
        .nav-user-edit {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            width: 100%;
            font-family: var(--sans);
            font-size: 0.68rem;
            font-weight: 300;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--or-clair);
            text-decoration: none;
            padding: 0.6rem;
            margin-bottom: 0.4rem;
            transition: color 0.3s;
        }
        .nav-user-edit:hover { color: var(--or); }
        .nav-user-logout {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            width: 100%;
            font-family: var(--sans);
            font-size: 0.68rem;
            font-weight: 300;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--gris);
            text-decoration: none;
            padding: 0.6rem;
            transition: color 0.3s;
        }
        .nav-user-logout:hover { color: #e8a39c; }
        .nav-user-edit svg,
        .nav-user-logout svg {
            width: 13px; height: 13px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2;
        }

        .burger {
            display: none;
            flex-direction: column;
            gap: 5px;
            cursor: pointer;
            background: none;
            border: none;
            padding: 4px;
        }
        .burger span {
            display: block;
            width: 26px; height: 1px;
            background: var(--creme);
            transition: all 0.3s;
        }

        /* ── SECTION GÉNÉRALE ── */
        section { padding: 7rem 2rem; }
        .container { max-width: 1200px; margin: 0 auto; }
        .section-label {
            font-family: var(--sans);
            font-size: 0.65rem;
            font-weight: 200;
            letter-spacing: 0.45em;
            text-transform: uppercase;
            color: var(--or);
            text-align: center;
            margin-bottom: 1rem;
        }
        .section-title {
            font-size: clamp(2.2rem, 5vw, 4rem);
            font-weight: 300;
            line-height: 1.1;
            text-align: center;
            margin-bottom: 1.5rem;
            color: var(--blanc);
        }
        .section-title em { font-style: italic; color: var(--or-clair); }
        .section-intro {
            font-size: 1.15rem;
            font-weight: 300;
            font-style: italic;
            color: var(--gris);
            text-align: center;
            max-width: 560px;
            margin: 0 auto 4rem;
            line-height: 1.7;
        }

        /* ── DIVIDER ── */
        .ornement {
            display: flex;
            align-items: center;
            gap: 1.2rem;
            justify-content: center;
            margin: 0 auto 3rem;
        }
        .ornement-line {
            width: 60px; height: 1px;
            background: linear-gradient(to right, transparent, var(--or));
        }
        .ornement-line.right { background: linear-gradient(to left, transparent, var(--or)); }
        .ornement-diamond {
            width: 7px; height: 7px;
            background: var(--or);
            transform: rotate(45deg);
        }

        /* ── FOOTER ── */
        footer {
            background: var(--noir);
            border-top: 1px solid rgba(184,150,90,0.15);
            padding: 4rem 2rem 2rem;
        }
        .footer-grid {
            display: grid;
            grid-template-columns: 1.5fr 1fr 1fr;
            gap: 3rem;
            max-width: 1200px;
            margin: 0 auto 3rem;
        }
        .footer-brand-name {
            font-size: 1.8rem;
            font-weight: 300;
            color: var(--or);
            margin-bottom: 0.3rem;
        }
        .footer-brand-tagline {
            font-size: 0.9rem;
            font-style: italic;
            color: var(--gris);
            margin-bottom: 1.5rem;
        }
        .footer-brand-desc {
            font-size: 0.95rem;
            font-weight: 300;
            font-style: italic;
            color: var(--gris);
            line-height: 1.7;
        }
        .footer-col-title {
            font-family: var(--sans);
            font-size: 0.62rem;
            font-weight: 300;
            letter-spacing: 0.35em;
            text-transform: uppercase;
            color: var(--or);
            margin-bottom: 1.2rem;
        }
        .footer-links { list-style: none; display: flex; flex-direction: column; gap: 0.6rem; }
        .footer-links a {
            font-size: 0.95rem;
            font-weight: 300;
            color: var(--gris);
            text-decoration: none;
            transition: color 0.3s;
        }
        .footer-links a:hover { color: var(--or-clair); }
        .footer-address {
            font-size: 0.95rem;
            font-weight: 300;
            font-style: italic;
            color: var(--gris);
            line-height: 1.8;
        }
        .footer-bottom {
            border-top: 1px solid rgba(184,150,90,0.1);
            padding-top: 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            max-width: 1200px;
            margin: 0 auto;
            flex-wrap: wrap;
            gap: 1rem;
        }
        .footer-copy {
            font-family: var(--sans);
            font-size: 0.6rem;
            font-weight: 200;
            letter-spacing: 0.2em;
            color: var(--gris);
            opacity: 0.6;
        }
        .footer-social {
            display: flex;
            gap: 1rem;
        }
        .footer-social a {
            width: 34px; height: 34px;
            border: 1px solid rgba(184,150,90,0.25);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--gris);
            text-decoration: none;
            transition: border-color 0.3s, color 0.3s;
        }
        .footer-social a:hover { border-color: var(--or); color: var(--or); }
        .footer-social svg { width: 15px; height: 15px; fill: currentColor; }

        /* ── ANIMATIONS ── */
        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        @keyframes scrollDown {
            0% { transform: scaleY(0); transform-origin: top; }
            50% { transform: scaleY(1); transform-origin: top; }
            51% { transform: scaleY(1); transform-origin: bottom; }
            100% { transform: scaleY(0); transform-origin: bottom; }
        }
        .reveal {
            opacity: 0;
            transform: translateY(40px);
            transition: opacity 0.8s ease, transform 0.8s ease;
        }
        .reveal.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* ── MOBILE NAV ── */
        .mobile-nav {
            display: none;
            position: fixed;
            inset: 0;
            background: var(--noir);
            z-index: 99;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 2.5rem;
        }
        .mobile-nav.open { display: flex; }
        .mobile-nav a {
            font-size: 2rem;
            font-weight: 300;
            color: var(--creme);
            text-decoration: none;
            font-family: var(--serif);
            font-style: italic;
            transition: color 0.3s;
        }
        .mobile-nav a:hover { color: var(--or); }
        .mobile-nav .mob-user-name {
            font-size: 1.1rem;
            font-family: var(--sans);
            letter-spacing: 0.15em;
            text-transform: uppercase;
            color: var(--or-clair);
        }
        .mobile-close {
            position: absolute;
            top: 1.5rem; right: 2rem;
            background: none;
            border: none;
            color: var(--gris);
            font-size: 2rem;
            cursor: pointer;
            font-family: var(--serif);
        }

        /* ── RESPONSIVE ── */

        @media (max-width: 900px) {
            nav { padding: 1.2rem 2rem; }
            nav.scrolled { padding: 0.8rem 2rem; }
            .nav-links, .nav-cta, .nav-user { display: none; }
            .burger { display: flex; }
            .footer-grid { grid-template-columns: 1fr; }
        }
        @media (max-width: 600px) {
            section { padding: 5rem 1.2rem; }
            .footer-bottom { flex-direction: column; text-align: center; }
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>

{# ── NAVIGATION ── #}
<nav id="navbar">
    <a href="{{ path('app_home') }}" class="nav-logo"> <span>L'Épicurien</span> </a>
    <ul class="nav-links">
        <li><a href="#about">Notre histoire</a></li>
        <li><a href="#menu">La Carte</a></li>
        <li><a href="#galerie">Galerie</a></li>
        <li><a href="#horaires">Horaires</a></li>
    </ul>

    {% if is_granted('ROLE_USER') %}
        <div class="nav-user" id="navUser">
            <button class="nav-user-trigger" id="navUserTrigger" aria-expanded="false">
                <span class="nav-user-name">{{ app.user.name }}</span>
                <svg class="nav-user-chevron" viewBox="0 0 10 6"><path d="M1 1l4 4 4-4"/></svg>
            </button>
            <div class="nav-user-panel" id="navUserPanel">
                <div class="nav-user-panel-header">
                    <div class="nav-user-panel-name">{{ app.user.name }} {{ app.user.lastname }}</div>
                    <div class="nav-user-panel-mail">{{ app.user.mail }}</div>
                </div>
                <div class="nav-user-panel-body">
                    <div class="nav-user-panel-row">
                        <span class="nav-user-panel-label">Téléphone</span>
                        <span class="nav-user-panel-value">{{ app.user.numberPhone }}</span>
                    </div>
                </div>
                <div class="nav-user-panel-footer">
                    <a href="{{ path('app_edit') }}" class="nav-user-edit">
                        <svg viewBox="0 0 24 24"><path d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                        Modifier mon profil
                    </a>
                    <a href="{{ path('app_logout') }}" class="nav-user-logout">
                        <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
                        Déconnexion
                    </a>
                </div>
            </div>
        </div>
    {% else %}
        <a href="{{ path('app_login') }}" class="nav-cta">Se connecter</a>
    {% endif %}

    <button class="burger" id="burger" aria-label="Menu">
        <span></span><span></span><span></span>
    </button>
</nav>

{# ── MENU MOBILE ── #}
<div class="mobile-nav" id="mobileNav">
    <button class="mobile-close" id="mobileClose">×</button>
    <a href="#about" class="mob-link">Notre histoire</a>
    <a href="#menu" class="mob-link">La Carte</a>
    <a href="#galerie" class="mob-link">Galerie</a>
    <a href="#horaires" class="mob-link">Horaires</a>

    {% if is_granted('ROLE_USER') %}
        <span class="mob-user-name">{{ app.user.name }}</span>
        <a href="{{ path('app_logout') }}" class="mob-link">Déconnexion</a>
    {% else %}
        <a href="{{ path('app_login') }}" class="mob-link">Se connecter</a>
    {% endif %}
</div>

{# ── CONTENU PRINCIPAL ── #}
{% block body %}{% endblock %}

{# ── FOOTER ── #}
{% include 'footer.html.twig' %}

<script>
    // Nav scroll
    const navbar = document.getElementById('navbar');
    window.addEventListener('scroll', () => {
        navbar.classList.toggle('scrolled', window.scrollY > 60);
    });

    // Mobile nav
    const burger = document.getElementById('burger');
    const mobileNav = document.getElementById('mobileNav');
    const mobileClose = document.getElementById('mobileClose');
    burger.addEventListener('click', () => mobileNav.classList.add('open'));
    mobileClose.addEventListener('click', () => mobileNav.classList.remove('open'));
    document.querySelectorAll('.mob-link').forEach(l =>
        l.addEventListener('click', () => mobileNav.classList.remove('open'))
    );

    // Dropdown compte utilisateur
    const navUser = document.getElementById('navUser');
    if (navUser) {
        const navUserTrigger = document.getElementById('navUserTrigger');
        navUserTrigger.addEventListener('click', (e) => {
            e.stopPropagation();
            const isOpen = navUser.classList.toggle('open');
            navUserTrigger.setAttribute('aria-expanded', isOpen);
        });
        document.addEventListener('click', (e) => {
            if (!navUser.contains(e.target)) {
                navUser.classList.remove('open');
                navUserTrigger.setAttribute('aria-expanded', 'false');
            }
        });
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                navUser.classList.remove('open');
                navUserTrigger.setAttribute('aria-expanded', 'false');
            }
        });
    }

    // Reveal on scroll
    const reveals = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); } });
    }, { threshold: 0.12 });
    reveals.forEach(el => observer.observe(el));
</script>
{% block javascripts %}{% endblock %}
</body>
</html>
